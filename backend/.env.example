PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/campus_bus?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

REDIS_URL=redis://127.0.0.1:6379

FIREBASE_PROJECT_ID=registration-a6358
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@registration-a6358.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

CORS_ORIGIN=*

# Stop detection (meters)
STOP_APPROACH_RADIUS_M=120
STOP_ARRIVAL_RADIUS_M=45

# Mark bus OFFLINE if no GPS/heartbeat for this many seconds
BUS_STALE_TIMEOUT_SEC=45

# Brevo (formerly Sendinblue) Transactional Email Service
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME="Campus Bus DHSGU"

# Seed accounts (used only by npm run seed)
SEED_DRIVER_EMAIL=driver@dhsgu.ac.in
SEED_DRIVER_PASSWORD=Driver@12345
SEED_ADMIN_EMAIL=admin@dhsgu.ac.in
SEED_ADMIN_PASSWORD=Admin@12345
SEED_BUS_NUMBER=BUS-04
